name = "xpw"
home = "https://github.com/bondbox/xpw/"
description = "Password management and authentication"
keywords = [ "access", "auth", "authentication", "ldap", "password",]
version = "0.16"

[authors]

[packages.xpw]
requires_python = ">=3.8"
authors = []
keywords = []
requirements = [ "xkits-command>=0.7", "xkits-file>=0.10", "xkits-lib>=0.5", "argon2-cffi", "ldap3", "toml",]
max_complexity = 10
max_line_length = 127

[packages.xpw.modules.xpw]
base = "xpw"
omitted = [ "attribute.py", "unittest/*",]
exclude = [ "unittest",]

[packages.xpw.modules.xpw.include]

[packages.xpw.modules.xpw.scripts]
randkey = "randkey:main"
pwhasher = "pwhasher:main"

[packages.xpw.modules.xpw.templates]
"attribute.py" = true
